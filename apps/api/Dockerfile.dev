FROM golang:1.23-alpine

WORKDIR /app

# Switch Alpine repositories from https to http to avoid TLS proxy inspection issues on CDN
RUN sed -i 's/https:/http:/g' /etc/apk/repositories && apk add --no-cache git curl ca-certificates

# Copy local proxy root certificates and update system CA store
COPY ca.crt* /usr/local/share/ca-certificates/
RUN update-ca-certificates || true

ENV GOPROXY=https://proxy.golang.org,direct
ENV GOINSECURE=*
ENV GIT_SSL_NO_VERIFY=true

# Pin air to a Go 1.23-compatible version
RUN go install github.com/air-verse/air@v1.61.7

COPY go.mod go.sum* ./
RUN go mod download || true

COPY . .

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
