# --- Project General ---
PROJECT_NAME=aura-tech

# --- PostgreSQL 16 Database ---
POSTGRES_USER=aura_admin
POSTGRES_PASSWORD=aura_secret_password
POSTGRES_DB=aura_ecommerce
POSTGRES_PORT=5432
DATABASE_URL=postgres://aura_admin:aura_secret_password@postgres:5432/aura_ecommerce?sslmode=disable

# --- MinIO (S3-Compatible Object Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=aura-assets
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000/aura-assets

# --- Backend (Go API) ---
# development | production. Production refuses to start with the sample JWT_SECRET or non-https CORS origins.
APP_ENV=development
API_PORT=8080
# Local key only. In production use a random secret of 32+ characters: openssl rand -base64 48
JWT_SECRET=aura_tech_local_jwt_secret_key_2026
# Storefront origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true only behind a reverse proxy that sets X-Forwarded-For (otherwise clients could fake their IP)
TRUST_PROXY=false
STOCK_LOCK_TTL_MINUTES=15
# API reference at http://localhost:8080/swagger/ (set to false in production)
SWAGGER_ENABLED=true

# --- Frontend (React + Vite) ---
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_STORAGE_URL=http://localhost:9000/aura-assets

# --- AI Asset Generation ---
GEMINI_API_KEY=your_gemini_api_key_here
